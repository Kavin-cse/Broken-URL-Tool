{
  "name": "devinspect-security-auditor",
  "version": "1.0.0",
  "description": "Passive web security auditing tool that inspects five Chromium DevTools surfaces for security-relevant indicators",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "ts-node src/tests/test-server.ts",
    "lint": "eslint src/ --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "security",
    "audit",
    "devtools",
    "playwright",
    "web-security"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "playwright": "^1.48.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "express": "^4.21.0",
    "@types/express": "^4.17.21",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "ts-node": "^10.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
